<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.embabel.agent</groupId>
    <artifactId>embabel-chat-store-parent</artifactId>
    <version>0.2.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Embabel Chat Store Parent</name>
    <description>Parent POM for Embabel Chat Store modules</description>

    <modules>
        <module>embabel-chat-store</module>
        <module>embabel-chat-store-autoconfigure</module>
        <module>embabel-agent-starter-chat-store</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <drivine.version>0.0.29</drivine.version>
        <kotlin.version>2.2.0</kotlin.version>
        <embabel-common.version>0.1.10-SNAPSHOT</embabel-common.version>
        <embabel-agent.version>0.4.0-SNAPSHOT</embabel-agent.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Project modules -->
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-chat-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-chat-store-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Embabel Agent API -->
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-agent-api</artifactId>
                <version>${embabel-agent.version}</version>
            </dependency>

            <!-- Embabel Common -->
            <dependency>
                <groupId>com.embabel.common</groupId>
                <artifactId>embabel-common-core</artifactId>
                <version>${embabel-common.version}</version>
            </dependency>

            <!-- Drivine -->
            <dependency>
                <groupId>org.drivine</groupId>
                <artifactId>drivine4j-spring-boot-starter</artifactId>
                <version>${drivine.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <args>
                            <arg>-Xjsr305=strict</arg>
                            <arg>-Xskip-metadata-version-check</arg>
                        </args>
                        <compilerPlugins>
                            <plugin>spring</plugin>
                        </compilerPlugins>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-allopen</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>embabel-releases</id>
            <url>https://repo.embabel.com/artifactory/libs-release</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>embabel-snapshots</id>
            <url>https://repo.embabel.com/artifactory/libs-snapshot</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>embabel-releases</id>
            <url>https://repo.embabel.com/artifactory/libs-release</url>
        </repository>
        <snapshotRepository>
            <id>embabel-snapshots</id>
            <url>https://repo.embabel.com/artifactory/libs-snapshot</url>
        </snapshotRepository>
    </distributionManagement>

</project>